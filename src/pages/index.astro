    <!-- Scripts -->
    <script>
      // Countdown Timer untuk Flash Sale
      function updateCountdown() {
        const now = new Date();
        const endOfDay = new Date();
        endOfDay.setHours(23, 59, 59, 999);
        
        const diff = endOfDay - now;
        
        const hours = Math.floor(diff / (1000 * 60 * 60));
        const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((diff % (1000 * 60)) / 1000);
        
        document.getElementById('hours').textContent = hours.toString().padStart(2, '0');
        document.getElementById('minutes').textContent = minutes.toString().padStart(2, '0');
        document.getElementById('seconds').textContent = seconds.toString().padStart(2, '0');
      }
      
      updateCountdown();
      setInterval(updateCountdown, 1000);

      // Filter Kategori
      document.addEventListener('DOMContentLoaded', () => {
        const categoryButtons = document.querySelectorAll('.category-btn');
        const productItems = document.querySelectorAll('.product-item');
        const emptyState = document.getElementById('empty-state');
        const productGrid = document.getElementById('product-grid');
        const sectionTitle = document.getElementById('section-title');
        const productCount = document.getElementById('product-count');

        const categoryNames = {
          'all': '🔥 PRODUK TERLARIS',
          'rumah': '🏠 PERLENGKAPAN RUMAH',
          'buku': ' BUKU & ALAT TULIS',
          'kecantikan': ' PERAWATAN & KECANTIKAN',
          'makanan': '🍜 MAKANAN & MINUMAN',
          'otomotif': '🏍️ OTOMOTIF',
          'elektronik': '📱 ELEKTRONIK',
          'fashion': '👕 FASHION',
        };

        categoryButtons.forEach(btn => {
          btn.addEventListener('click', () => {
            const selectedCategory = btn.getAttribute('data-category');
            
            // Reset semua tombol
            categoryButtons.forEach(b => {
              b.classList.remove('bg-gradient-to-br', 'from-orange-50', 'to-red-50', 'border-orange-200');
            });
            
            // Highlight tombol yang diklik
            btn.classList.add('bg-gradient-to-br', 'from-orange-50', 'to-red-50', 'border-orange-200');

            // Update judul
            const categoryName = categoryNames[selectedCategory] || 'PRODUK';
            sectionTitle.innerHTML = `<span class="bg-gradient-to-r from-orange-500 to-red-500 text-white px-4 py-1.5 rounded-lg">${categoryName}</span>`;

            // Filter produk
            let visibleCount = 0;
            productItems.forEach(item => {
              const itemCategory = item.getAttribute('data-category');
              if (selectedCategory === 'all' || itemCategory === selectedCategory) {
                item.style.display = 'block';
                visibleCount++;
              } else {
                item.style.display = 'none';
              }
            });

            // Update jumlah produk & empty state
            productCount.textContent = `${visibleCount} Produk`;
            if (visibleCount === 0) {
              emptyState.classList.remove('hidden');
              productGrid.classList.add('hidden');
            } else {
              emptyState.classList.add('hidden');
              productGrid.classList.remove('hidden');
            }

            // Scroll ke section produk
            productGrid.scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
        });

        // Search functionality
        const searchInput = document.getElementById('search-input');
        searchInput.addEventListener('input', (e) => {
          const searchTerm = e.target.value.toLowerCase();
          let visibleCount = 0;
          
          productItems.forEach(item => {
            const productName = item.querySelector('h3').textContent.toLowerCase();
            if (productName.includes(searchTerm)) {
              item.style.display = 'block';
              visibleCount++;
            } else {
              item.style.display = 'none';
            }
          });

          productCount.textContent = `${visibleCount} Produk`;
          if (visibleCount === 0 && searchTerm !== '') {
            emptyState.classList.remove('hidden');
            productGrid.classList.add('hidden');
          } else {
            emptyState.classList.add('hidden');
            productGrid.classList.remove('hidden');
          }
        });
      });
    </script>
