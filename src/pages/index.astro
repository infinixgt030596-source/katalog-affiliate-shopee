---
import ProductCard from '../components/ProductCard.astro';
import products from '../data/products.json';
---

<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Katalog Shopee Affiliate</title>
  </head>
  <body class="bg-gray-100 min-h-screen">
    <header class="bg-orange-500 text-white py-4 shadow-lg sticky top-0 z-50">
      <div class="container mx-auto px-4 flex items-center justify-between">
        <h1 class="text-xl md:text-2xl font-bold">🛒 Racun Shopee</h1>
        <span class="text-xs md:text-sm bg-white text-orange-500 px-3 py-1 rounded-full font-semibold">Affiliate Catalog</span>
      </div>
    </header>
    
    <main class="container mx-auto px-4 py-6">
      <h2 class="text-lg font-semibold text-gray-700 mb-4 flex items-center gap-2">
        🔥 Produk Trending Hari Ini
      </h2>
      
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3 md:gap-4">
        {products.map((product) => (
          <ProductCard {...product} />
        ))}
      </div>
    </main>

    <footer class="bg-white border-t mt-12 py-6 text-center text-gray-500 text-sm">
      <p>Dibuat dengan ❤️ menggunakan Astro & Tailwind CSS</p>
      <p class="text-xs mt-1">Link di atas adalah link affiliate. Terima kasih sudah mendukung!</p>
    </footer>
  </body>
</html>
